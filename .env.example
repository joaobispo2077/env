AI_MEMORY_HOST_DATA_DIR=C:/ai-memory-data

# ChatGPT OAuth consolidation. Login once: ai-memory auth login openai-oauth
# The account catalog rejects gpt-5.5, gpt-5.4-mini, and gpt-5-mini.
# Use a slug the account lists. This machine's Codex model is gpt-6.1-sol.
AI_MEMORY_LLM_PROVIDER=openai-oauth
AI_MEMORY_LLM_MODEL=gpt-6.1-sol

# Local embeddings need no API key. Session-end consolidation is opt-in.
AI_MEMORY_EMBEDDING_PROVIDER=local
AI_MEMORY_CONSOLIDATE_ON_SESSION_END=true

# Rerank search hits with the same OAuth model. Queries still return if it fails.
AI_MEMORY_RERANKER=llm

# Optional API-key providers. Leave unset when using openai-oauth and local embeddings.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
